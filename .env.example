# ==============================================================================
# TAFAWOK CRE — Environment Variables Template for Local & Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Required)
# ------------------------------------------------------------------------------
# Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Public Key (Both names supported interchangeably)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Connection String (Server-only / Scripts — NEVER add NEXT_PUBLIC_)
# For Supabase Session/Transaction pooler: port 6543 or 5432
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Initial Super Admin credentials for scripts (scripts/create-admin.ts)
ADMIN_EMAIL=admin@tafawok.co
ADMIN_PASSWORD=your-secure-admin-password

# ------------------------------------------------------------------------------
# 2. Site URL & Canonical Base (Required for Production)
# ------------------------------------------------------------------------------
# In Vercel, this can be your production domain: https://www.tafawok.co
# (If omitted on Vercel preview branches, the app automatically falls back to VERCEL_URL)
NEXT_PUBLIC_SITE_URL=https://www.tafawok.co

# ------------------------------------------------------------------------------
# 3. SMTP Mail Delivery Configuration (Optional)
# ------------------------------------------------------------------------------
# If left empty during development/preview, contact form inquiries safely log
# to the server console and save to Supabase database with a 200 OK response.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=info@tafawok.co

# ------------------------------------------------------------------------------
# 4. Search Engine Webmaster Verification Tokens (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
