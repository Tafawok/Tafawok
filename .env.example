# ==============================================================================
# TAFAWOK CRE — Site URL & Search Engine Webmaster Verification
# ==============================================================================
# Canonical production site URL (must begin with https:// and have no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tafawok.co

# Google Search Console Verification Token (found in GSC HTML tag / meta verification)
# Example: 1a2b3c4d5e6f7g8h9i0j_EXAMPLE_TOKEN
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools Verification Token (msvalidate.01)
# Example: 1234567890ABCDEF1234567890ABCDEF
NEXT_PUBLIC_BING_VERIFICATION=

# Yandex Webmaster Verification Token (Optional)
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ==============================================================================
# TAFAWOK CRE — SMTP Mail Delivery Service Configuration
# ==============================================================================
# When configured, inquiries submitted through the contact portal and RFQ dialogs
# will be transmitted via secure SMTP to the corporate commercial desk.
#
# If left empty or unset during local development, inquiries will safely log
# to the server console in preview mode with a 200 OK response.
# ==============================================================================

# Outgoing SMTP Server Host (e.g. smtp.gmail.com, mail.tafawok.co, smtp.office365.com)
SMTP_HOST=

# Outgoing SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use Secure Connection (true for port 465, false for port 587/STARTTLS)
SMTP_SECURE=false

# Authenticated SMTP User / Email Address
SMTP_USER=

# Authenticated SMTP Password or App-Specific Password
SMTP_PASS=

# Target Receiver Email for Commercial Inquiries (Defaults to info@tafawok.co)
CONTACT_RECEIVER_EMAIL=info@tafawok.co
